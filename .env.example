# Required: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=

# Keep true in production. HTTPS is mandatory when this is true.
SESSION_COOKIE_SECURE=true

# Optional; demo login is disabled unless both this and the ?key= value are supplied.
DEMO_SECRET=

# Required for secure password-reset OTP delivery. Leave unset to disable resets.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional LinkedIn OpenID Connect startup registration.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
